---
// The bar across the top: the studio's mark and name, the chapters menu, and the two ways to reach the studio.
// Light on the paintings, ink on the paper (html[data-theme]).
import { company } from '../content/site';
import { chapters } from '../content/edition';

const wa = `https://wa.me/${company.contact.whatsapp}?text=${encodeURIComponent('Hello Raphael Studios, I would like to talk about a project.')}`;
---

<header class="bar" data-bar>
  <div class="bar__left">
    <a class="bar__brand" href="#top" aria-label={`${company.name}, back to the top`}>
      <svg class="bar__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path
          fill="currentColor"
          d="M7 4h11.2c5.5 0 8.6 2.7 8.6 7.1 0 3.4-1.9 5.6-5.2 6.4l6.4 10.5h-5.4l-5.9-9.9h-4.9V28H7V4Zm4.8 4.1v6.2h5.9c3.1 0 4.4-1.1 4.4-3.1 0-2.1-1.4-3.1-4.4-3.1h-5.9Z"
        ></path>
      </svg>
      <span class="bar__name">{company.name}</span>
      <span class="bar__desc">{company.descriptor}</span>
    </a>
    <div class="bar__menu" data-menu>
      <button class="bar__link bar__toggle" type="button" aria-expanded="false" aria-controls="chapters-menu" data-menu-toggle>
        Chapters
        <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      </button>
      <div class="bar__drop" id="chapters-menu" hidden data-lenis-prevent>
        <ol role="list">
          {
            chapters.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="bar__drop-num">{c.numeral}</span>
                  <span class="bar__drop-name">{c.full}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <a class="bar__drop-all" href="#contact">Contact the studio ↘</a>
      </div>
    </div>
    <a class="bar__link bar__hide-sm" href="#atelier">Atelier</a>
  </div>
  <div class="bar__right">
    <a class="bar__link bar__hide-sm" href={wa} target="_blank" rel="noopener">WhatsApp</a>
    <a class="bar__pill" href="#contact">Let’s talk</a>
  </div>
</header>

<style>
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px var(--gutter) 0;
    color: var(--light);
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 0.3s var(--ease-in-out);
    opacity: 0;
    transform: translateY(-100%);
  }
  .bar {
    animation: bar-in 0.6s var(--ease-out) 0.55s both;
  }
  @keyframes bar-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(html[data-nav-theme='paper']) .bar {
    color: var(--ink);
  }
  /* two floating glass pills: blurred over the paintings, frosted white over the paper */
  .bar__left,
  .bar__right {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    height: 44px;
    padding: 0 6px 0 16px;
    border-radius: 999px;
    background: rgb(20 20 14 / 0.26);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    transition:
      background-color 0.4s var(--ease-in-out),
      box-shadow 0.4s var(--ease-in-out);
  }
  .bar__left {
    padding-right: 18px;
  }
  :global(html[data-nav-theme='paper']) .bar__left,
  :global(html[data-nav-theme='paper']) .bar__right {
    background: rgb(255 255 255 / 0.62);
    box-shadow:
      inset 0 0 0 1px rgb(40 40 28 / 0.08),
      0 10px 30px -18px rgb(40 40 28 / 0.4);
  }
  .bar__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .bar__mark {
    width: 18px;
    height: 18px;
    color: var(--turq-bright);
  }
  :global(html[data-nav-theme='paper']) .bar__mark {
    color: var(--turq-deep);
  }
  .bar__name {
    font-weight: 700;
  }
  .bar__desc {
    opacity: 0.6;
    font-weight: 600;
  }
  .bar__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 0;
    transition: opacity 0.2s;
  }
  .bar__link:hover {
    opacity: 0.7;
  }
  .bar__toggle svg {
    width: 9px;
    transition: rotate 0.3s var(--ease-out);
  }
  .bar__toggle[aria-expanded='true'] svg {
    rotate: 180deg;
  }
  .bar__menu {
    position: relative;
  }
  .bar__drop {
    position: absolute;
    top: calc(100% + 10px);
    left: -14px;
    min-width: 290px;
    padding: 10px;
    border-radius: 10px;
    background: rgb(20 20 14 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--light);
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.5);
  }
  .bar__drop ol {
    margin: 0;
    padding: 0;
  }
  .bar__drop a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 7px 8px;
    border-radius: 6px;
  }
  .bar__drop a:hover,
  .bar__drop a:focus-visible {
    background: rgb(255 255 255 / 0.08);
  }
  .bar__drop-num {
    width: 2.2em;
    font-family: var(--font-display);
    font-size: 0.7rem;
    opacity: 0.6;
  }
  .bar__drop-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
  }
  .bar__drop-all {
    margin-top: 6px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-weight: 700;
    color: var(--turq-bright);
  }
  .bar__pill {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 16px;
    white-space: nowrap;
    border-radius: 999px;
    background: var(--light);
    color: var(--black);
    font-weight: 700;
    transition:
      background-color 0.3s var(--ease-in-out),
      color 0.3s var(--ease-in-out);
  }
  .bar__pill:hover {
    background: var(--turq-bright);
  }
  :global(html[data-nav-theme='paper']) .bar__pill {
    background: var(--ink);
    color: var(--light);
  }
  :global(html[data-nav-theme='paper']) .bar__pill:hover {
    background: var(--turq-deep);
  }
  @media (max-width: 760px) {
    .bar__hide-sm,
    .bar__desc {
      display: none;
    }
  }
</style>
